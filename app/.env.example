# Client-visible backend API URL
# For local development: http://localhost:8001
# For production: your backend deployment URL
PUBLIC_API_URL=http://localhost:8001

# Browser calls use the same-origin server proxy when this is empty.
PUBLIC_CATALOG_API_URL=
PUBLIC_ANALYSIS_REQUEST_API_URL=/oem-api

# Private upstreams and credentials used only by the Node server.
CATALOG_API_URL=http://127.0.0.1:8000
OEM_INTERFACE_URL=http://127.0.0.1:5055
CATALOG_API_KEY=
OEM_INTERFACE_API_KEY=

# Node adapter runtime configuration.
ORIGIN=http://localhost:5173
BODY_SIZE_LIMIT=25M

# Local Python/CKAN tools are disabled unless explicitly enabled.
# Set true only when their use is intended and the app is suitably restricted.
ENABLE_LOCAL_SIMULATION_TOOLS=false

# Fixed SSP template simulation integration.
TEMPLATE_SIM_PYTHON=python-client/python_venv/bin/python
TEMPLATE_SIM_FILE_SERVICE_URL=https://localhost:5000
TEMPLATE_SIM_TIMESERIES_URL=https://localhost:5002
TEMPLATE_SIM_FILE_SERVICE_USER=cloud
TEMPLATE_SIM_FILE_SERVICE_PASSWORD=
RABBITMQ_DEFAULT_HOST=localhost
RABBITMQ_DEFAULT_PORT=5672
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=
TS3_LAUNCHER_STATUS_HISTORY_QUEUE_COUNT=1
